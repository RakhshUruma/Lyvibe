# === Mood gen ===
VITE_ANTHROPIC_API_KEY=
VITE_ANTHROPIC_MODEL=claude-sonnet-4-6
VITE_ANTHROPIC_THINKING_BUDGET=2048
VITE_ANTHROPIC_PROMPT_CACHE=true

VITE_GEMINI_API_KEY=
VITE_GEMINI_MOOD_MODEL=gemini-2.5-pro

# === ASR ===
VITE_ASR_PRIMARY=openai
VITE_OPENAI_API_KEY=
VITE_OPENAI_TRANSCRIBE_MODEL=whisper-1
# NOTE: gpt-4o-transcribe / gpt-4o-mini-transcribe do NOT return timestamps
# (response_format=verbose_json is unsupported), so they fall back to a single
# whole-track segment. Use whisper-1 for proper line-by-line sync.
VITE_GEMINI_ASR_MODEL=gemini-2.5-pro
VITE_ASSEMBLYAI_API_KEY=

# === Subscription relay (任意) ===
VITE_RELAY_URL=http://127.0.0.1:8787

# === Behavior ===
VITE_STREAMING=true
VITE_USE_FILES_API_THRESHOLD_MB=18

# === Server-only (relay/vj-mcp.ts) ===
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
RELAY_PORT=8787
